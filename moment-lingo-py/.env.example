# 复制为 .env 后填入真实值

# ===== 阿里云 AccessKey =====
# 用途: 短信验证码服务 (Dypnsapi) 鉴权
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# ===== 火山引擎 方舟大模型 (Volcengine Ark) =====
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 用途: 大语言模型 (LLM) API Key
VOLCENGINE_API_KEY=

# ===== 火山引擎 豆包语音合成 (TTS) =====
# 用途: 语音合成 WebSocket 鉴权 (App ID + Access Key)
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_KEY=

# ===== MiniMax 大模型 =====
# 用途: MiniMax 接口密钥
MINIMAX_API_KEY=

# ===== 阿里云百炼 (DashScope / 通义千问) =====
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 用途: 百炼大模型 API Key
BAILIAN_API_KEY=

# ===== Redis 缓存 =====
# 用途: 会话令牌/业务缓存
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0

# ===== MySQL 数据库 =====
DB_NAME=
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=

# ===== Mem0 记忆服务 =====
# 用途: AI 记忆存储
MEM0_API_KEY=
MEM0_HOST=

# ===== Meilisearch 全文搜索 =====
# 用途: 搜索服务鉴权 (master/api key)
MEILI_HOST=
MEILI_API_KEY=
